# For GitHub Pages: set VITE_MAPBOX_ACCESS_TOKEN as a repo Actions secret (not in git).
# For optional local builds only: copy to .env.local (gitignored).
#
# Mapbox public token (pk.*) — https://account.mapbox.com/access-tokens/
# On Mapbox, allow URL: https://*.github.io/*
VITE_MAPBOX_ACCESS_TOKEN=
